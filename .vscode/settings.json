{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.pyrefly.configFile": "${workspaceFolder}/pyrefly.toml",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/backend"
  ],
  "python.analysis.exclude": [
    "**/_legacy/**",
    "**/node_modules/**",
    "**/.venv/**"
  ],
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  }
}
